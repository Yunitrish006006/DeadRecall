  "unassignedGameplay": {
    "temporaryRepository": "DeadRecall",
    "policy": "Future gameplay remains in DeadRecall until a bounded-context repository is approved; never move gameplay into TotemCore merely to empty the compatibility repository.",
    "knownAreas": [
      "future gameplay without an approved bounded context"
    ]
  },
  "dependencyRules": [
    "TotemCore must not depend on feature repositories",
    "Feature repositories depend only on TotemCore by default",
    "Cross-feature behavior uses versioned public APIs, events or optional adapters",
