{
  "schemaVersion": 1,
  "id": "deadrecall",
  "version": "${version}",
  "name": "DeadRecall",
  "description": "Exact-version Totem compatibility bundle and legacy item-ID migration host.",
  "license": "BSD-3-Clause",
  "icon": "assets/deadrecall/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.adaptor.deadrecall.Deadrecall"
    ]
