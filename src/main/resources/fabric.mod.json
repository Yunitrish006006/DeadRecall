    "minecraft": "${minecraft_version}",
    "totem-core": "=0.4.0",
    "totem-remnant": "=0.1.7",
    "totem-discord-bridge": "=0.1.4",
    "totem-automata": "=0.1.9",
    "totem-alchemy": "=0.1.7",
    "totem-enchanting": "=0.1.3",
    "totem-vanilla-tweaks": "=0.1.5",
    "totem-nexus": "=0.2.2"
  }
}
